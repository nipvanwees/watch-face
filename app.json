{
  "configVersion": "v3",
  "app": {
    "appId": 21986,
    "appName": "Minimal",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Vintage analog watch face with heart rate, stretch, water and steps"
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "debug": false,
  "targets": {
    "trex3pro": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Minimal"
    }
  },
  "defaultLanguage": "en-US"
}
